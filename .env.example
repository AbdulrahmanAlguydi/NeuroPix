# Copy this file to .env and replace the placeholders with your own values.
# Keep .env private. Never commit credentials to Git.
# Quotes are useful when a value contains spaces or # characters.

# MySQL
# For Amazon RDS, set DB_HOST to your RDS endpoint.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=neuropix_db
DB_USER=your_mysql_user
DB_PASSWORD="your_mysql_password"

# Amazon S3
# Use your own bucket and its AWS region.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=eu-north-1

# Flask
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret

# OpenAI (only required for OpenAI editing)
# Set a supported image-editing model available to your account.
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=your_supported_image_editing_model

# Local Stable Diffusion (optional)
# Uncomment for Flask and Docker running on the same computer.
# LOCAL_MODEL_URL=http://127.0.0.1:8000/predict
# On EC2, use port 8001 instead when your reverse SSH tunnel is active.
